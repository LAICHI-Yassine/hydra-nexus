# 1. On part d'un système Linux allégé avec Python pré-installé
FROM python:3.11-slim

# 2. On définit le dossier de travail dans le conteneur
WORKDIR /app

# 3. On copie le fichier des dépendances
COPY requirements.txt .

# 4. On installe les dépendances
RUN pip install --no-cache-dir -r requirements.txt

# 5. On copie tout le reste du code (main.py, le dossier qdrant, etc.)
COPY . .

# 6. On ouvre le port 8000 pour que le conteneur puisse communiquer avec l'extérieur
EXPOSE 8000

# 7. La commande pour lancer le serveur
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]