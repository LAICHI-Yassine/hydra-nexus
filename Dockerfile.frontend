# 1. On part d'un système Linux allégé
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

# 2. On copie l'interface et le dossier de configuration (.streamlit)
COPY ui.py .
COPY .streamlit/ .streamlit/

# 3. On ouvre le port standard de Streamlit
EXPOSE 8501

# 4. La commande pour lancer l'interface
CMD ["streamlit", "run", "ui.py", "--server.address=0.0.0.0"]